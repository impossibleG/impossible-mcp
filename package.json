{
  "name": "@impossible-g/mcp-server-template",
  "version": "0.1.0",
  "private": true,
  "description": "A production-minded TypeScript template for local and remote MCP servers.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "check:package": "node scripts/check-generated.mjs",
    "check:privacy": "node scripts/privacy-check.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "tsx watch src/cli.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "npm run check:privacy && npm run format && npm run lint && npm run check && npm run test:coverage && npm run build && npm run check:package"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "commander": "15.0.0",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.11.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.5"
  },
  "bin": {
    "impossible-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
